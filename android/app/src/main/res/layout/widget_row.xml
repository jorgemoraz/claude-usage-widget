            <TextView android:id="@+id/g_5h" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFB366" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />

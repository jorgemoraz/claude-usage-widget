<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UsoDeClaude</AssemblyName>
    <RootNamespace>UsoDeClaude</RootNamespace>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version>1.0.$(BuildNumber)</Version>
    <Product>Uso de Claude</Product>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="..\sprites\*.png" LogicalName="sprites.%(Filename).png" />
  </ItemGroup>
</Project>
